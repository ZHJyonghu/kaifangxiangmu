# ============================================================
# UniTrade 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# ============================================================

# NextAuth.js (必填)
# 生产环境使用: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (可选)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API Base URL (必填)
API_BASE_URL=http://localhost:8080/api/v1

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_LISTING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
