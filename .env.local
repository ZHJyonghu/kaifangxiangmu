# ============================================================
# UniTrade 前端环境变量
# ============================================================

# NextAuth.js
AUTH_SECRET=your-auth-secret-change-me-in-production
AUTH_URL=http://localhost:3000

# OAuth Providers (生产环境替换真实值)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API
API_BASE_URL=http://localhost:8080/api/v1

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_LISTING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
